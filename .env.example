DATABASE_URL=postgres://ui:replace-with-a-strong-password@localhost:5432/ui
# Generate with: ui-rust keygen. Never commit the real key; back it up separately.
APP_KEY=
APP_URL=http://localhost:8080
BIND=127.0.0.1:8080
RUST_LOG=ui_rust=info,tower_http=info

# Optional SePay. If HMAC is set it takes precedence over API key authentication.
SEPAY_API_KEY=
SEPAY_HMAC_SECRET=
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK_CODE=

# Required for email OTP and password recovery. SMTP uses STARTTLS on port 587.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Only used by the one-time create-admin command. Remove after provisioning.
ADMIN_EMAIL=
ADMIN_PASSWORD=
